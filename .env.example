# Copy this file to ".env" and fill in the values. NEVER commit ".env".
#
# GOOGLE_SERVICE_ACCOUNT_B64 = base64 of the whole service-account JSON key file.
#   Windows PowerShell (one line):
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
#   Paste the resulting single line below (no quotes, no line breaks).
GOOGLE_SERVICE_ACCOUNT_B64=

# The spreadsheet id (already filled from your pricelist URL).
GOOGLE_SHEET_ID=1CYEQoHsCT66yfVYnIG8e5Nt2GnPk2yyflkQYwmI49Fg
